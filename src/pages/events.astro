---
import Base from '../layouts/Base.astro';
---
<style>
  .events-list {
    margin-top: var(--space-md);
  }
  .event__image {
    width: 100%;
    max-height: 340px;
    object-fit: cover;
    object-position: center;
    display: block;
    margin-bottom: var(--space-sm);
  }
  .event {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .event__date {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 0.25rem;
  }
  .event__title {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    margin-bottom: 0.25rem;
  }
  .event__location {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }
  .event__desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-top: 0.4rem;
    max-width: 680px;
  }
  .event__desc a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .event__link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .no-events {
    color: var(--color-text-secondary);
    font-style: italic;
    padding: var(--space-md) 0;
  }
</style>
<Base title="Events — Jane Yevgenia Muschenetz" description="Upcoming readings, talks, and public appearances by Jane Muschenetz.">
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Events</h1>
      <p class="page-hero__subtitle">Upcoming readings, talks, and public appearances.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="events-list">

        <div class="event">
          <img src="/images/queen-califia.jpg" alt="Queen Califia's Magical Circle, Escondido" class="event__image">
          <p class="event__date">August 14, 2026 &middot; 6–8pm</p>
          <h2 class="event__title">Poetry at Queen Califia's Magical Circle</h2>
          <p class="event__location">Kit Carson Park, Escondido, CA</p>
          <p class="event__desc">A curated evening of women poets performing in Niki de Saint Phalle's final public work — a garden of mosaic statues covered in sparkling stones, reflective glass, and colorful ceramic tiles. Jane joins featured readers Karla Cordero, Tracey Knapp, and Patricia Aya Williams. Organized by <a href="https://thepoetryshop.com" target="_blank" rel="noopener">The Poetry Shop</a>'s Katie Kemple. All ages. Book sales on site.</p>
        </div>

        <div class="event">
          <img src="/images/pfs-banner.jpg" alt="Poets for Science Gathering" class="event__image">
          <p class="event__date">November 12–14, 2026</p>
          <h2 class="event__title">The Poet's Laboratory — Poets for Science Gathering</h2>
          <p class="event__location">Kent State University, Kent, OH</p>
          <p class="event__desc">Panel with Katie Manning at the Poets for Science Gathering. Speakers include current US Poet Laureate Arthur Sze, Maria Popova, Jane Hirshfield, Tracy K. Smith, and others.</p>
          <a href="https://poetsforscience.org/gathering-2026/" target="_blank" rel="noopener" class="event__link">Learn More</a>
        </div>

      </div>
    </div>
  </section>
</Base>
